<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TheVoidRewrite.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:TheVoidRewrite.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="TheVoidRewrite.Views.NameView"
        x:DataType="vm:NameViewModel">

        <UserControl.Styles>
            <Style Selector="TextBox.messageInput">
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="20"/>
                <Setter Property="Padding" Value="15"/>
                <Setter Property="Background" Value="#111111"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="CornerRadius" Value="15"/>
                <Setter Property="PlaceholderText" Value="Type Message Here..."/>
                <Setter Property="FontFamily" Value="{StaticResource LowerPixel}"/>
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="LetterSpacing" Value="1"/>
                <Setter Property="Foreground" Value="#EEEEEE"></Setter>
            </Style>

            <Style Selector="TextBox.messageInput:focus /template/ Border#PART_BorderElement">
                <Setter Property="Background" Value="#111111"/>
                <Setter Property="BorderBrush" Value="#111111"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>

            <Style Selector="TextBox.messageInput:pointerover /template/ Border#PART_BorderElement">
                <Setter Property="BorderBrush" Value="#111111"/>
                <Setter Property="Background" Value="#111111"/>
            </Style>
        </UserControl.Styles>

    <StackPanel>
        <ColorView Name="ColourPicker"  IsAlphaEnabled="False" IsAlphaVisible="False" IsAccentColorsVisible="False" IsColorPaletteVisible="False" Color="{Binding NameColour}"/>

        <TextBox Name="NameBox" Classes="messageInput" Text="{Binding NameInputText, Mode=TwoWay}" MaxLength="75" TextAlignment="DetectFromContent" FontSize="50" PlaceholderText="Type Username Here...">
            <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding SubmitNameCommand}"/>
            </TextBox.KeyBindings>
        </TextBox>
    </StackPanel>

</UserControl>